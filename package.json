{
	"name": "smart-media-replacement",
	"version": "1.3.0",
	"description": "Replace media library files with revision tracking, and audit which files are actually used.",
	"author": "Troy Chaplin",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"lint-staged": {
		"*.{css,scss}": [
			"stylelint --fix",
			"git add"
		],
		"*.js": [
			"wp-scripts format",
			"wp-scripts lint-js",
			"git add"
		],
		"*.php": [
			"composer run format",
			"git add"
		]
	},
	"scripts": {
		"start": "webpack --config webpack.scripts.js --watch",
		"build": "rm -rf build && npm run build:scripts",
		"build:scripts": "wp-scripts build --webpack-copy-php --config webpack.scripts.js",
		"format": "npm run format:js && npm run format:css && npm run format:php",
		"format:js": "wp-scripts lint-js --fix",
		"format:css": "wp-scripts lint-style \"src/**/*.{css,scss}\" --fix",
		"format:php": "./vendor/bin/phpcbf --standard=phpcs.xml.dist -v",
		"lint": "npm run lint:js && npm run lint:css && npm run lint:php",
		"lint:js": "wp-scripts lint-js --max-warnings=0",
		"lint:css": "wp-scripts lint-style \"src/**/*.{css,scss}\"",
		"lint:php": "composer run lint",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"prepare": "husky"
	},
	"files": [
		"[^.]*"
	],
	"devDependencies": {
		"@wordpress/a11y": "^4.52.0",
		"@wordpress/api-fetch": "^7.50.0",
		"@wordpress/components": "^35.0.1",
		"@wordpress/core-data": "^7.52.0",
		"@wordpress/data": "^10.52.0",
		"@wordpress/dataviews": "^16.0.1",
		"@wordpress/element": "^8.2.0",
		"@wordpress/env": "^10.34.0",
		"@wordpress/eslint-plugin": "^25.4.0",
		"@wordpress/hooks": "^4.52.0",
		"@wordpress/i18n": "^6.23.0",
		"@wordpress/icons": "^14.0.1",
		"@wordpress/notices": "^5.52.0",
		"@wordpress/prettier-config": "^4.48.0",
		"@wordpress/scripts": "^32.6.0",
		"@wordpress/stylelint-config": "^23.40.0",
		"eslint-config-prettier": "10.1.8",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"stylelint": "^16.25.0",
		"stylelint-scss": "^6.12.1",
		"webpack": "^5.102.1",
		"webpack-cli": "^6.0.1"
	}
}
